diff --git a/knowledge_harness/templates/vault/editorconfig b/knowledge_harness/templates/vault/editorconfig
new file mode 100644
index 0000000..02c3ee2
--- /dev/null
+++ b/knowledge_harness/templates/vault/editorconfig
@@ -0,0 +1,37 @@
+# Defends the machine-owned surfaces (literatures/, log/,
+# inbox/review-queue.md, system/bibliography.json) against ANY editor's
+# defaults, including the user's own -- not against this file's, which
+# imposes none. An editor that trims trailing whitespace or appends a
+# final newline on save would corrupt the append-only queue's byte-exact
+# contract or desync bibliography.json from what Better BibTeX wrote.
+# `false` is an active override, so it wins even where the user's own
+# editor is configured to do this globally; omitting the property
+# instead would yield to that global config, which is the threat this
+# file exists to stop. `root = true` makes this file authoritative: no
+# ancestor .editorconfig is read, so these overrides cannot be diluted
+# by one. Every other vault file is left to the user's own editor and
+# conventions -- this file makes no claim about them.
+#
+# charset/end_of_line have no boolean "off" in the EditorConfig spec, so
+# they are not set here: with no [*] section and root = true blocking
+# ancestor files, there is nothing in this file's scope for `unset` to
+# undo, so it would be inert. This is a real, accepted residual gap: an
+# editor's own charset/line-ending default (not sourced from
+# EditorConfig) can still touch these four surfaces.
+root = true
+
+[literatures/**]
+insert_final_newline = false
+trim_trailing_whitespace = false
+
+[log/**]
+insert_final_newline = false
+trim_trailing_whitespace = false
+
+[inbox/review-queue.md]
+insert_final_newline = false
+trim_trailing_whitespace = false
+
+[system/bibliography.json]
+insert_final_newline = false
+trim_trailing_whitespace = false
