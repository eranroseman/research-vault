# research-vault
sources/
.worktrees/
.claude/worktrees/
# SDD scratch — Concerns route to durable homes at write time; the skill
# deletes this at Finish (post-q's committed workspace predates the rule)
.superpowers/
# PDFs belong in Zotero (spec §2 preservation boundary); recovering a primary
# into sources/ is a deliberate act: git add -f + a README table row.
.mutate4py/
lcov.info
# wildcard also matches mutate4py's <db>.test-context-cache.json sidecar
.contexts.db*
# mutmut's working copy: schemata, .meta results, stats cache (scripts/mutation_gate.py)
mutants/

# Python
__pycache__/
*.py[codz]
*.egg-info/
/build/
dist/

# Merge artifacts (parallel sessions share this checkout)
*.orig
*.rej
.DS_Store

# Test / coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.lcov
.pytest_cache/
.hypothesis/

# Environments
.env
.env*
.envrc
.venv
env/
venv/

# Tool caches
.mypy_cache/
.ruff_cache/

# The status-marking pass's reviewable proposal, and every split or scratch
# variant of it. Glob, not the one name: the bare name let
# disposition-proposal-documents.tsv sit untracked and unignored.
disposition-proposal*.tsv

# SDD workspaces. AGENTS.md rules these are never a durable home: the skill's
# Finish step deletes them, and a Concern's disposition belongs in an issue or a
# spec. 71 files of a merged plan's scratch were tracked anyway, which made the
# repo's largest documentation surface a completed workspace nobody reads.
.superpowers/
