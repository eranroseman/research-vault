+def test_real_verify_cli_states_rw_leg_absence_without_rw_csv(net_vault, capsys):
+    """An unarmed RW leg must say so, exactly once, on a run with no --rw-csv.
+
+    Absence of the flag is a network+license act deliberately not taken —
+    the honest CLI output is a stdout line, not a review-queue entry (the
+    SKIPPED-counting lesson: a queue item nobody has to acknowledge invites
+    rubber-stamping).
+    """
+    code = main(["verify", "--vault", str(net_vault), "--offline"])
+    output = capsys.readouterr().out
+
+    assert code == 0
+    assert output.count("update-notice: RW leg not run (no --rw-csv)") == 1
+    assert not [
+        entry
+        for entry in inbox.open_entries(net_vault)
+        if entry.check == "update-notice"
+    ]
+
+
